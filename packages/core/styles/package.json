{
  "name": "@vezham/styles",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/vx-fe-pkgs-timeline.git",
    "directory": "packages/core/styles"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "style": "./index.css",
      "default": "./index.css"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.css",
  "style": "./index.css",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:copy && pnpm run build:minify",
    "build:copy": "node scripts/copy-css.mjs",
    "build:minify": "npx @tailwindcss/cli -i ./dist/index.css -o dist/vezham.min.css --minify",
    "clean": "rm -rf dist",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "dependencies": {
    "@vx-oss/heroui-v3-styles": "^3.0.0-beta.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "clean-package": "2.2.0",
    "rimraf": "6.0.1",
    "tailwindcss": "4.1.13"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "clean-package": "./clean-package.config.json"
}
